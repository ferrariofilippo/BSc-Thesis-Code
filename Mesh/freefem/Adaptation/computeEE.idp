func real computeEE(
    mesh & Th,
    real[int] & vv
) {
    include "./freefem/Adaptation/makepatch.idp";

    fespace Xh0(Th, P0);
    fespace Xh1(Th, P1);

    Xh0 vol = area;
    Xh0 eta2K = 0;
    Xh1 v;
    v[] = vv;

    Xh0 dxv = dx(v);
    Xh0 dyv = dy(v);

    int ne = Th.nt;
    int[int] nextK(ne);
    int[int,int] patch(ne, 1000);
    nextK = 1;
    makepatch(patch, nextK, Th);

    for (int k = 0; k < ne; k++) {
        real px = 0.;
        real py = 0.;
        real vpatch = 0.;

        for (int j = 0; j < nextK(k); j++) {
            int patchElement = patch(k, j);
            px += dxv[][patchElement] * vol[][patchElement];
            py += dyv[][patchElement] * vol[][patchElement];
            vpatch += vol[][patchElement];
        }
        px /= vpatch;
        py /= vpatch;

        // |patch_K| cancels the normalization of GK. Accumulate its
        // unnormalized trace directly; no eigendecomposition is needed.
        for (int j = 0; j < nextK(k); j++) {
            int patchElement = patch(k, j);
            real Ex = px - dxv[][patchElement];
            real Ey = py - dyv[][patchElement];
            eta2K[][k] += (Ex * Ex + Ey * Ey) * vol[][patchElement];
        }
    }

    return eta2K[].sum;
}

